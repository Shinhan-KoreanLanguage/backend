# Application
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_BASE_URL=http://localhost:8080

# Database
DB_URL=jdbc:mysql://localhost:3306/shinhan_capstone?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# JWT
# 시크릿 키는 최소 32바이트(영문 32자) 이상이어야 합니다.
JWT_SECRET=change-me-to-at-least-32-bytes-secret
JWT_ACCESS_EXP_MIN=60
JWT_REFRESH_EXP_DAY=30

# File Upload (로컬 스토리지, 추후 S3 전환 예정)
FILE_UPLOAD_DIR=uploads
FILE_URL_PREFIX=http://localhost:8080/images
DEFAULT_PROFILE_IMAGE_URL=http://localhost:8080/images/default-profile.png

# Google Developer Console
# Redirect URI는 구글 콘솔 등록값 / 프론트 인가 요청값과 정확히 일치해야 합니다.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback/google

# Meta for Developers / Facebook Login
FACEBOOK_CLIENT_ID=change-me
FACEBOOK_CLIENT_SECRET=change-me
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_REDIRECT_URI=http://localhost:3000/oauth/callback/facebook

# Open AI
OPENAI_API_KEY=change-me
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# AI 분석 서버 (FastAPI) — 각자 팀 서버 주소로 설정
AI_SERVER_URL=http://localhost:8000

# 아래는 선택 항목입니다. 비워두면 application.yml에 정의된 기본값이 사용됩니다.
# PAGE_MAX_SIZE=100
# PAGE_DEFAULT_SIZE=20
# MULTIPART_MAX_FILE_SIZE=50MB
# MULTIPART_MAX_REQUEST_SIZE=100MB
# JACKSON_CASE_INSENSITIVE_ENUMS=true
# SWAGGER_UI_PATH=/swagger-ui.html
# SWAGGER_TAGS_SORTER=alpha
# SWAGGER_OPERATIONS_SORTER=alpha
# SWAGGER_DEFAULT_CONSUMES=application/json
# SWAGGER_DEFAULT_PRODUCES=application/json
# LOG_LEVEL_SECURITY=DEBUG
# LOG_LEVEL_HIBERNATE_SQL=DEBUG
